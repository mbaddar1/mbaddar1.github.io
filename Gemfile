source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

# Needed to run Jekyll locally on newer Ruby (Ubuntu's ruby-full is 3.x):
# these were removed from Ruby's default gems.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"

# github-pages already bundles every plugin listed in _config.yml
# (paginate, sitemap, gist, feed, jemoji, include-cache, remote-theme)
# at the versions GitHub Pages runs, so they aren't listed separately.
